{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "read_file|read_many_files|write_file|replace|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "name": "kit-guards",
            "command": "sdkit hook --host gemini PreToolUse",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "name": "kit-fmt",
            "command": "sdkit hook --host gemini PostToolUse",
            "timeout": 20000
          }
        ]
      }
    ]
  }
}
