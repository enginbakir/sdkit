{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "sdkit hook --host cursor PreToolUse",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "sdkit hook --host cursor PreToolUse",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write|Delete",
        "command": "sdkit hook --host cursor PreToolUse",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "sdkit hook --host cursor PostToolUse",
        "timeout": 20
      }
    ]
  }
}
